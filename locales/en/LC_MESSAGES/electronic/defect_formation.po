#, python-brace-format
msgid ""
"x\\Delta\\mu_{\\rm A}+y\\Delta\\mu_{\\rm B}=\\Delta H_{\\rm f}[{\\rm "
"A}_x{\\rm B}_y],\n"
"\\qquad\n"
"\\Delta\\mu_{\\rm A}\\le0,\\quad\\Delta\\mu_{\\rm B}\\le0"
