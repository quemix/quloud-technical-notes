#: ../../ml/appendix/gaussian_dist.rst:5
msgid "ガウス分布関数"
msgstr "Gaussian Distribution Function"

#: ../../ml/appendix/gaussian_dist.rst:7
msgid "一次元"
msgstr "One dimension"

#: ../../ml/appendix/gaussian_dist.rst:9
msgid ""
"\\mathcal{N}(x|\\mu, \\sigma^2)\n"
"= \\frac{1}{\\sqrt{2\\pi\\sigma^2}}\n"
"\\exp{\\left( -\\frac{(x-\\mu)^2}{2\\sigma^2} \\right)}\n"
"\n"
msgstr ""
"\\mathcal{N}(x|\\mu, \\sigma^2)\n"
"= \\frac{1}{\\sqrt{2\\pi\\sigma^2}}\n"
"\\exp{\\left( -\\frac{(x-\\mu)^2}{2\\sigma^2} \\right)}\n"
"\n"

#: ../../ml/appendix/gaussian_dist.rst:15
msgid "N次元"
msgstr "N dimensions"

#: ../../ml/appendix/gaussian_dist.rst:17
msgid ""
"\\mathcal{N}(\\boldsymbol{x}|\\boldsymbol{\\mu}, \\boldsymbol{\\Sigma})\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N\\left|\\boldsymbol{\\Sigma}\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}(\\boldsymbol{x}-\\boldsymbol{\\mu})^\\top\n"
"\\boldsymbol{\\Sigma}^{-1}\n"
"(\\boldsymbol{x}-\\boldsymbol{\\mu})\n"
"\\right)}\n"
"\n"
msgstr ""
"\\mathcal{N}(\\boldsymbol{x}|\\boldsymbol{\\mu}, \\boldsymbol{\\Sigma})\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N\\left|\\boldsymbol{\\Sigma}\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}(\\boldsymbol{x}-\\boldsymbol{\\mu})^\\top\n"
"\\boldsymbol{\\Sigma}^{-1}\n"
"(\\boldsymbol{x}-\\boldsymbol{\\mu})\n"
"\\right)}\n"
"\n"

