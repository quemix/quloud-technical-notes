#: ../../ml/bayes.rst:5
msgid "ベイズ推定"
msgstr "Bayesian Inference"

#: ../../ml/bayes.rst:9
msgid "パラメータの事後分布"
msgstr "Posterior Distribution of the Parameters"

#: ../../ml/bayes.rst:11
msgid "パラメータに対する事前分布として、つぎの\\ :ref:`ガウス分布<gaussian_dist>`\\ を考える"
msgstr ""
"For the prior distribution of the parameters, take the following \\ "
":ref:`Gaussian distribution <gaussian_dist>`\\ ."

#: ../../ml/bayes.rst:13
msgid ""
"p(\\boldsymbol{w})\n"
"=\n"
"\\mathcal{N}(\\boldsymbol{w} | \\boldsymbol{m}_0, \\boldsymbol{S}_0)\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^M\\left|\\boldsymbol{S}_0\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_0)^\\top\n"
"\\boldsymbol{S}_0^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_0)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{w})\n"
"=\n"
"\\mathcal{N}(\\boldsymbol{w} | \\boldsymbol{m}_0, \\boldsymbol{S}_0)\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^M\\left|\\boldsymbol{S}_0\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_0)^\\top\n"
"\\boldsymbol{S}_0^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_0)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:27
#, python-brace-format
msgid ""
"\\ :math:`\\boldsymbol{w}`\\ （と入力\\ :math:`\\boldsymbol{X}`\\ ）が与えられたときの "
"\\ :math:`\\boldsymbol{t}` の分布（\\ :ref:`尤度関数<likelihood_function>`\\ ）は、式"
" :eq:`ml3`"
msgstr ""
"Given \\ :math:`\\boldsymbol{w}`\\  (and the inputs \\ "
":math:`\\boldsymbol{X}`\\ ), we model the distribution of \\ "
":math:`\\boldsymbol{t}` using the \\ :ref:`likelihood function "
"<likelihood_function>`\\  in Equation :eq:`ml3`."

#: ../../ml/bayes.rst:30
msgid ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N(\\sigma_\\varepsilon^2)^N}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2\\sigma_\\varepsilon^2}\n"
"(\\boldsymbol{t}-\\boldsymbol{\\Phi}\\boldsymbol{w})^\\top\n"
"(\\boldsymbol{t}-\\boldsymbol{\\Phi}\\boldsymbol{w})\n"
"\\right)}\n"
"\n"
msgstr ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N(\\sigma_\\varepsilon^2)^N}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2\\sigma_\\varepsilon^2}\n"
"(\\boldsymbol{t}-\\boldsymbol{\\Phi}\\boldsymbol{w})^\\top\n"
"(\\boldsymbol{t}-\\boldsymbol{\\Phi}\\boldsymbol{w})\n"
"\\right)}\n"
"\n"

#: ../../ml/bayes.rst:40
#, python-brace-format
msgid "でモデル化する。このときの :math:`\\boldsymbol{w}` の事後分布を計算する"
msgstr ""
"With this model, we calculate the posterior distribution of "
":math:`\\boldsymbol{w}` as follows."

#: ../../ml/bayes.rst:42
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"= \\frac{\n"
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"}{p(\\boldsymbol{t} | \\boldsymbol{X})} ,\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"= \\frac{\n"
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"}{p(\\boldsymbol{t} | \\boldsymbol{X})} ,\n"
"\n"

#: ../../ml/bayes.rst:50
#, python-brace-format
msgid ""
"p(\\boldsymbol{t} | \\boldsymbol{X})\n"
"=\n"
"\\int p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})d\\boldsymbol{w} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{t} | \\boldsymbol{X})\n"
"=\n"
"\\int p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})d\\boldsymbol{w} .\n"
"\n"

#: ../../ml/bayes.rst:57
#, python-brace-format
msgid ""
"式 :eq:`bayes2` の分子を書き下すと次のようになる （\\ :math:`\\beta \\equiv "
"\\sigma^{-2}_\\varepsilon` とおく）"
msgstr ""
"The numerator of Equation :eq:`bayes2` expands as shown below, where we "
"set \\ :math:`\\beta \\equiv \\sigma^{-2}_\\varepsilon`."

#: ../../ml/bayes.rst:61
msgid ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{N+M}(\\beta^{-1})^N\\left|\\boldsymbol{S}_0\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{\\beta}{2}\n"
"\\left( \\boldsymbol{t} - \\boldsymbol{\\Phi}\\boldsymbol{w} "
"\\right)^\\top\n"
"\\left( \\boldsymbol{t} - \\boldsymbol{\\Phi}\\boldsymbol{w} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_0 \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_0\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_0 \\right)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{N+M}(\\beta^{-1})^N\\left|\\boldsymbol{S}_0\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{\\beta}{2}\n"
"\\left( \\boldsymbol{t} - \\boldsymbol{\\Phi}\\boldsymbol{w} "
"\\right)^\\top\n"
"\\left( \\boldsymbol{t} - \\boldsymbol{\\Phi}\\boldsymbol{w} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_0 \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_0\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_0 \\right)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:79
#, python-brace-format
msgid "これを :math:`\\boldsymbol{w}` について整理する"
msgstr "Rearranging this expression in terms of :math:`\\boldsymbol{w}` gives"

#: ../../ml/bayes.rst:81
msgid ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"\\propto\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)^\\top\n"
"\\boldsymbol{S}_1^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{t} | \\boldsymbol{X}, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"\\propto\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)^\\top\n"
"\\boldsymbol{S}_1^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:93 ../../ml/bayes.rst:359
msgid "ここで、"
msgstr "Here we make the following definitions."

#: ../../ml/bayes.rst:95
#, python-brace-format
msgid ""
"\\boldsymbol{S}_1^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_0^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{\\Phi} ,\n"
"\n"
msgstr ""
"\\boldsymbol{S}_1^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_0^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{\\Phi} ,\n"
"\n"

#: ../../ml/bayes.rst:103
#, python-brace-format
msgid ""
"\\boldsymbol{m}_1\n"
"\\equiv\n"
"\\boldsymbol{S}_1\n"
"\\left(\n"
"\\boldsymbol{S}_0^{-1} \\boldsymbol{m}_0\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{t}\n"
"\\right)\n"
"\n"
msgstr ""
"\\boldsymbol{m}_1\n"
"\\equiv\n"
"\\boldsymbol{S}_1\n"
"\\left(\n"
"\\boldsymbol{S}_0^{-1} \\boldsymbol{m}_0\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{t}\n"
"\\right)\n"
"\n"

#: ../../ml/bayes.rst:113
#, python-brace-format
msgid ""
"とおいた。係数や\\ :math:`\\boldsymbol{w}` を含まない項は分母と打ち消し合うので、 結局 :eq:`bayes2` "
"は、つぎの\\ :ref:`ガウス分布<gaussian_dist>`\\ となる"
msgstr ""
"The prefactors and the terms that do not depend on \\ "
":math:`\\boldsymbol{w}` cancel between the numerator and denominator. "
"Thus the posterior in Equation :eq:`bayes2` is the following \\ "
":ref:`Gaussian distribution <gaussian_dist>`\\ ."

#: ../../ml/bayes.rst:116
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_1\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)^\\top\n"
"\\boldsymbol{S}_1^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_1\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)^\\top\n"
"\\boldsymbol{S}_1^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_1)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:132
msgid "逐次学習"
msgstr "Sequential Learning"

#: ../../ml/bayes.rst:134
msgid "式 :eq:`pgp3` の :math:`N` 個のデータに加え、新たに :math:`N_2` 個のデータを得たという状況を考える"
msgstr ""
"Suppose the data set in Equation :eq:`pgp3` contains :math:`N` data "
"points and we obtain :math:`N_2` more as follows."

#: ../../ml/bayes.rst:137
msgid ""
"\\boldsymbol{D}_2\n"
"\\equiv\n"
"\\{(\\boldsymbol{x}_{N+1}, t_{N+1}), \\; (\\boldsymbol{x}_{N+2}, "
"t_{N+2}),\n"
"\\; \\dots \\; (\\boldsymbol{x}_{N+N_2}, t_{N+N_2}) \\} .\n"
"\n"
msgstr ""
"\\boldsymbol{D}_2\n"
"\\equiv\n"
"\\{(\\boldsymbol{x}_{N+1}, t_{N+1}), \\; (\\boldsymbol{x}_{N+2}, "
"t_{N+2}),\n"
"\\; \\dots \\; (\\boldsymbol{x}_{N+N_2}, t_{N+N_2}) \\} .\n"
"\n"

#: ../../ml/bayes.rst:144
msgid "また、式 :eq:`pgp6` に対応する次式を定義しておく"
msgstr "We also define the following counterpart to Equation :eq:`pgp6`."

#: ../../ml/bayes.rst:146
#, python-brace-format
msgid ""
"\\boldsymbol{\\Phi}_2\n"
"\\equiv\n"
"\\begin{pmatrix}\n"
"\\phi_0(\\boldsymbol{x}_{N+1}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+1}) \\\\\n"
"\\phi_0(\\boldsymbol{x}_{N+2}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+2}) \\\\\n"
"\\vdots & \\cdots & \\vdots \\\\\n"
"\\phi_0(\\boldsymbol{x}_{N+N_2}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+N_2}) \\\\\n"
"\\end{pmatrix} .\n"
"\n"
msgstr ""
"\\boldsymbol{\\Phi}_2\n"
"\\equiv\n"
"\\begin{pmatrix}\n"
"\\phi_0(\\boldsymbol{x}_{N+1}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+1}) \\\\\n"
"\\phi_0(\\boldsymbol{x}_{N+2}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+2}) \\\\\n"
"\\vdots & \\cdots & \\vdots \\\\\n"
"\\phi_0(\\boldsymbol{x}_{N+N_2}) & \\cdots & "
"\\phi_{M-1}(\\boldsymbol{x}_{N+N_2}) \\\\\n"
"\\end{pmatrix} .\n"
"\n"

#: ../../ml/bayes.rst:156
#, python-brace-format
msgid "この状況で、今度は :eq:`bayes8` を事前分布として、 パラメータ :math:`\\boldsymbol{w}` の事後分布を考える"
msgstr ""
"We now use Equation :eq:`bayes8` as the prior distribution and consider "
"the posterior distribution of the parameters :math:`\\boldsymbol{w}`."

#: ../../ml/bayes.rst:159
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_2, \\boldsymbol{t}_2, "
"\\boldsymbol{X}, \\boldsymbol{t})\n"
"= \\frac{\n"
"p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, \\boldsymbol{w})\n"
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"}{p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, \\boldsymbol{X}, "
"\\boldsymbol{t})} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_2, \\boldsymbol{t}_2, "
"\\boldsymbol{X}, \\boldsymbol{t})\n"
"= \\frac{\n"
"p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, \\boldsymbol{w})\n"
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{t})\n"
"}{p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, \\boldsymbol{X}, "
"\\boldsymbol{t})} .\n"
"\n"

#: ../../ml/bayes.rst:167
#, python-brace-format
msgid ""
"\\ :math:`p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, \\boldsymbol{w})` "
"として再び :eq:`ml3` を用いるならば、 この事後分布の計算は、 :eq:`bayes8` を求めたときと全く同じになる。すなわち"
msgstr ""
"If we again model \\ :math:`p(\\boldsymbol{t}_2 | \\boldsymbol{X}_2, "
"\\boldsymbol{w})` using Equation :eq:`ml3`, the calculation of this "
"posterior distribution follows exactly the same steps as the derivation "
"of Equation :eq:`bayes8`. We make the following definitions."

#: ../../ml/bayes.rst:170
#, python-brace-format
msgid ""
"\\boldsymbol{S}_2^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_1^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2 ,\n"
"\n"
msgstr ""
"\\boldsymbol{S}_2^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_1^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2 ,\n"
"\n"

#: ../../ml/bayes.rst:178
#, python-brace-format
msgid ""
"\\boldsymbol{m}_2\n"
"\\equiv\n"
"\\boldsymbol{S}_2\n"
"\\left(\n"
"\\boldsymbol{S}_1^{-1} \\boldsymbol{m}_1\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right) .\n"
"\n"
msgstr ""
"\\boldsymbol{m}_2\n"
"\\equiv\n"
"\\boldsymbol{S}_2\n"
"\\left(\n"
"\\boldsymbol{S}_1^{-1} \\boldsymbol{m}_1\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right) .\n"
"\n"

#: ../../ml/bayes.rst:188
msgid "を定義すれば、 :eq:`bayes10` は以下のように書ける"
msgstr "With these definitions, Equation :eq:`bayes10` can be written as follows."

#: ../../ml/bayes.rst:190
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_2, \\boldsymbol{t}_2, "
"\\boldsymbol{X}, \\boldsymbol{t})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_2\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_2)^\\top\n"
"\\boldsymbol{S}_2^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_2)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_2, \\boldsymbol{t}_2, "
"\\boldsymbol{X}, \\boldsymbol{t})\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_2\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_2)^\\top\n"
"\\boldsymbol{S}_2^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_2)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:204
msgid "結局、常に\\ :ref:`ガウス分布<gaussian_dist>`\\ に戻るので、 明らかにこのプロセスは何度でも繰り返すことができる。"
msgstr ""
"Since the result is always a \\ :ref:`Gaussian distribution "
"<gaussian_dist>`\\ , the process can clearly be repeated any number of "
"times."

#: ../../ml/bayes.rst:209
msgid "逐次学習とバッチ学習の等価性"
msgstr "Equivalence of Sequential Learning and Batch Learning"

#: ../../ml/bayes.rst:211
#, python-brace-format
msgid ""
"今度は :math:`N+N_2` 個のデータが最初からあるという状況で、 :eq:`bayes1` の事前分布に戻ってパラメータ "
":math:`\\boldsymbol{w}` の事後分布"
msgstr ""
"Suppose all :math:`N+N_2` data points are available from the start. Using"
" the prior distribution in Equation :eq:`bayes1` again, we calculate the "
"posterior distribution of the parameters :math:`\\boldsymbol{w}`."

#: ../../ml/bayes.rst:214
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{X}_2, \\boldsymbol{t}, "
"\\boldsymbol{t}_2)\n"
"= \\frac{\n"
"p(\\boldsymbol{t}, \\boldsymbol{t}_2 | \\boldsymbol{X}, "
"\\boldsymbol{X}_2, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"}{p(\\boldsymbol{t}, \\boldsymbol{t}_2 | \\boldsymbol{X}, "
"\\boldsymbol{X}_2)}\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}, \\boldsymbol{X}_2, \\boldsymbol{t}, "
"\\boldsymbol{t}_2)\n"
"= \\frac{\n"
"p(\\boldsymbol{t}, \\boldsymbol{t}_2 | \\boldsymbol{X}, "
"\\boldsymbol{X}_2, \\boldsymbol{w})\n"
"p(\\boldsymbol{w})\n"
"}{p(\\boldsymbol{t}, \\boldsymbol{t}_2 | \\boldsymbol{X}, "
"\\boldsymbol{X}_2)}\n"
"\n"

#: ../../ml/bayes.rst:222
msgid "の計算を行う。\\ :eq:`bayes6` および :eq:`bayes7` に対応する式は、"
msgstr ""
"The counterparts of Equations \\ :eq:`bayes6` and :eq:`bayes7` are shown "
"below."

#: ../../ml/bayes.rst:224
msgid ""
"\\tilde{\\boldsymbol{S}}_1^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_0^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{\\Phi}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2\n"
"=\n"
"\\boldsymbol{S}_1^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2\n"
"=\n"
"\\boldsymbol{S}_2^{-1}\n"
"\n"
msgstr ""
"\\tilde{\\boldsymbol{S}}_1^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_0^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{\\Phi}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2\n"
"=\n"
"\\boldsymbol{S}_1^{-1}\n"
"+\n"
"\\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{\\Phi}_2\n"
"=\n"
"\\boldsymbol{S}_2^{-1}\n"
"\n"

#: ../../ml/bayes.rst:240
msgid ""
"\\tilde{\\boldsymbol{m}}_1\n"
"\\equiv\n"
"\\tilde{\\boldsymbol{S}}_1\n"
"\\left(\n"
"\\boldsymbol{S}_0^{-1} \\boldsymbol{m}_0\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{t}\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right)\n"
"=\n"
"\\boldsymbol{S}_2\n"
"\\left(\n"
"\\boldsymbol{S}_1^{-1} \\boldsymbol{m}_1\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right)\n"
"=\n"
"\\boldsymbol{m}_2\n"
"\n"
msgstr ""
"\\tilde{\\boldsymbol{m}}_1\n"
"\\equiv\n"
"\\tilde{\\boldsymbol{S}}_1\n"
"\\left(\n"
"\\boldsymbol{S}_0^{-1} \\boldsymbol{m}_0\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top \\boldsymbol{t}\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right)\n"
"=\n"
"\\boldsymbol{S}_2\n"
"\\left(\n"
"\\boldsymbol{S}_1^{-1} \\boldsymbol{m}_1\n"
"+ \\beta \\boldsymbol{\\Phi}_2^\\top \\boldsymbol{t}_2\n"
"\\right)\n"
"=\n"
"\\boldsymbol{m}_2\n"
"\n"

#: ../../ml/bayes.rst:259
msgid ""
"となるので、事後分布は :eq:`bayes13` と全く同じものになることがわかる。このことは、 "
"データを大量に用意して一度に学習させても（バッチ学習）、 小分けにして少しずつ学習させても（逐次学習）、結果は変わらないことを示している。 "
"そこまでの学習の成果は次式に集約されることになる"
msgstr ""
"These expressions show that the posterior distribution is identical to "
"that in Equation :eq:`bayes13`. Thus learning from a large data set all "
"at once (batch learning) gives the same result as learning from it in "
"small batches (sequential learning). The following equation summarizes "
"what has been learned so far."

#: ../../ml/bayes.rst:264
msgid ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_N\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_N)^\\top\n"
"\\boldsymbol{S}_N^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_N)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{w} | \\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{1}{\n"
"\\sqrt{(2\\pi)^{M} \\left|\\boldsymbol{S}_N\\right|}\n"
"}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_N)^\\top\n"
"\\boldsymbol{S}_N^{-1}\n"
"(\\boldsymbol{w}-\\boldsymbol{m}_N)\n"
"\\right)} .\n"
"\n"

#: ../../ml/bayes.rst:280
msgid "出力データの予測分布"
msgstr "Predictive Distribution of the Outputs"

#: ../../ml/bayes.rst:282
#, python-brace-format
msgid ""
"パラメータの事前分布として式 :eq:`bayes15` が得られているという状況で、新たな入力 "
":math:`\\boldsymbol{X}_{\\rm new}` に対する :math:`\\boldsymbol{t}_{\\rm "
"new}` の予測分布を考える。これは次式で計算される"
msgstr ""
"Given Equation :eq:`bayes15` as the prior distribution of the parameters,"
" consider the predictive distribution for new inputs "
":math:`\\boldsymbol{X}_{\\rm new}` and their outputs "
":math:`\\boldsymbol{t}_{\\rm new}`. We calculate this distribution as "
"follows."

#: ../../ml/bayes.rst:285
#, python-brace-format
msgid ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\int p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{w})\n"
"p(\\boldsymbol{w} |  \\boldsymbol{X}_N, \\boldsymbol{t}_N) "
"d\\boldsymbol{w} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\int p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{w})\n"
"p(\\boldsymbol{w} |  \\boldsymbol{X}_N, \\boldsymbol{t}_N) "
"d\\boldsymbol{w} .\n"
"\n"

#: ../../ml/bayes.rst:292
msgid "上式の被積分関数は :eq:`bayes4` と同じ形"
msgstr "The integrand above has the same form as in Equation :eq:`bayes4`."

#: ../../ml/bayes.rst:294
msgid ""
"\\exp{\\left(\n"
"-\\frac{\\beta}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{w} \\right)^\\top\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{w} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_N\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N \\right)\n"
"\\right)}\n"
"\n"
msgstr ""
"\\exp{\\left(\n"
"-\\frac{\\beta}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{w} \\right)^\\top\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{w} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_N\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N \\right)\n"
"\\right)}\n"
"\n"

#: ../../ml/bayes.rst:305
#, python-brace-format
msgid ""
"であるが、今度は分子／分母で積分に関係しない項が打ち消しあうということは使えない。そこで、見通しよく計算を進めるために、 まず "
":math:`\\boldsymbol{w}` と :math:`\\boldsymbol{t}_{\\rm new}` "
"の同時分布を考える。上式の指数の中身を整理する"
msgstr ""
"This time, however, we cannot cancel terms independent of the integration"
" variable between the numerator and the denominator as we did before. To "
"make the calculation easier to follow, we first consider the joint "
"distribution of :math:`\\boldsymbol{w}` and :math:`\\boldsymbol{t}_{\\rm "
"new}`. We rearrange the exponent above as follows."

#: ../../ml/bayes.rst:308
#, python-brace-format
msgid ""
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} &\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new} &\n"
"\\beta\\boldsymbol{I} \\\\\n"
"\\end{pmatrix}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} \\\\\n"
"\\boldsymbol{t}_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"+\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"-\\frac{1}{2}\n"
"\\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N\n"
"\n"
msgstr ""
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} &\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new} &\n"
"\\beta\\boldsymbol{I} \\\\\n"
"\\end{pmatrix}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} \\\\\n"
"\\boldsymbol{t}_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"+\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"-\\frac{1}{2}\n"
"\\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N\n"
"\n"

#: ../../ml/bayes.rst:329
#, python-brace-format
msgid ""
"= -\\frac{1}{2}\n"
"\\left[\n"
"\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"-\\left( \\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1} \\;\\; "
"\\boldsymbol{0} \\right)\n"
"\\boldsymbol{R}^\\top\n"
"\\right]\n"
"\\boldsymbol{R}^{-1}\n"
"\\left[\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} \\\\\n"
"\\boldsymbol{t}_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"-\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"\\right]\n"
"+\\frac{1}{2}\n"
"\\left( \\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1} \\;\\; "
"\\boldsymbol{0} \\right)\n"
"\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"-\\frac{1}{2}\n"
"\\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N .\n"
"\n"
msgstr ""
"= -\\frac{1}{2}\n"
"\\left[\n"
"\\left( \\boldsymbol{w}^\\top \\;\\; \\boldsymbol{t}_{\\rm new}^\\top "
"\\right)\n"
"-\\left( \\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1} \\;\\; "
"\\boldsymbol{0} \\right)\n"
"\\boldsymbol{R}^\\top\n"
"\\right]\n"
"\\boldsymbol{R}^{-1}\n"
"\\left[\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} \\\\\n"
"\\boldsymbol{t}_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"-\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"\\right]\n"
"+\\frac{1}{2}\n"
"\\left( \\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1} \\;\\; "
"\\boldsymbol{0} \\right)\n"
"\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"-\\frac{1}{2}\n"
"\\boldsymbol{m}_N^\\top\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N .\n"
"\n"

#: ../../ml/bayes.rst:361
#, python-brace-format
msgid ""
"\\boldsymbol{R}^{-1}\n"
"\\equiv\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} &\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new} &\n"
"\\beta\\boldsymbol{I} \\\\\n"
"\\end{pmatrix}\n"
"\n"
msgstr ""
"\\boldsymbol{R}^{-1}\n"
"\\equiv\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} &\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"-\\beta\\boldsymbol{\\Phi}_{\\rm new} &\n"
"\\beta\\boldsymbol{I} \\\\\n"
"\\end{pmatrix}\n"
"\n"

#: ../../ml/bayes.rst:372
#, python-brace-format
msgid ""
"とおいた。\\ :math:`\\boldsymbol{R}` は\\ :ref:`ブロック行列の逆行列の公式<matform_block>`\\"
" より"
msgstr ""
"By the \\ :ref:`formula for the inverse of a block matrix "
"<matform_block>`\\ , \\ :math:`\\boldsymbol{R}` is"

#: ../../ml/bayes.rst:374
#, python-brace-format
msgid ""
"\\boldsymbol{R}\n"
"=\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N &\n"
"\\boldsymbol{S}_N \\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"\\boldsymbol{\\Phi}_{\\rm new} \\boldsymbol{S}_N &\n"
"\\beta^{-1}\\boldsymbol{I} + \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{S}_N\\boldsymbol{\\Phi}^\\top_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"\n"
msgstr ""
"\\boldsymbol{R}\n"
"=\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N &\n"
"\\boldsymbol{S}_N \\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"\\boldsymbol{\\Phi}_{\\rm new} \\boldsymbol{S}_N &\n"
"\\beta^{-1}\\boldsymbol{I} + \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{S}_N\\boldsymbol{\\Phi}^\\top_{\\rm new} \\\\\n"
"\\end{pmatrix}\n"
"\n"

#: ../../ml/bayes.rst:385
msgid "となる。これから、"
msgstr "From this we find"

#: ../../ml/bayes.rst:387
#, python-brace-format
msgid ""
"\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"=\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{\\Phi}_{\\rm new}\\boldsymbol{m}_N \\\\\n"
"\\end{pmatrix}\n"
"\n"
msgstr ""
"\\boldsymbol{R}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{S}_N^{-1}\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{0} \\\\\n"
"\\end{pmatrix}\n"
"=\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{\\Phi}_{\\rm new}\\boldsymbol{m}_N \\\\\n"
"\\end{pmatrix}\n"
"\n"

#: ../../ml/bayes.rst:400
msgid "と計算されるので、 :eq:`bayes18` は、右辺第2項と第3項が打ち消し合い、最終的に次のようになる"
msgstr ""
"Hence the second and third terms on the right-hand side of Equation "
":eq:`bayes18` cancel, and the expression reduces to"

#: ../../ml/bayes.rst:402
#, python-brace-format
msgid ""
"-\\frac{1}{2}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w}^\\top - \\boldsymbol{m}_N^\\top &\n"
"\\boldsymbol{t}_{\\rm new}^\\top - "
"\\boldsymbol{m}_N^\\top\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"\\end{pmatrix}\n"
"\\boldsymbol{R}^{-1}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} - \\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\\\\n"
"\\end{pmatrix} \\\\\n"
"\n"
msgstr ""
"-\\frac{1}{2}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w}^\\top - \\boldsymbol{m}_N^\\top &\n"
"\\boldsymbol{t}_{\\rm new}^\\top - "
"\\boldsymbol{m}_N^\\top\\boldsymbol{\\Phi}_{\\rm new}^\\top \\\\\n"
"\\end{pmatrix}\n"
"\\boldsymbol{R}^{-1}\n"
"\\begin{pmatrix}\n"
"\\boldsymbol{w} - \\boldsymbol{m}_N \\\\\n"
"\\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\\\\n"
"\\end{pmatrix} \\\\\n"
"\n"

#: ../../ml/bayes.rst:414
#, python-brace-format
msgid ""
"=\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N - "
"\\boldsymbol{S}_{N+1}\\boldsymbol{m}^{\\prime}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N - "
"\\boldsymbol{S}_{N+1}\\boldsymbol{m}^{\\prime}_{N+1} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\n"
msgstr ""
"=\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N - "
"\\boldsymbol{S}_{N+1}\\boldsymbol{m}^{\\prime}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_N - "
"\\boldsymbol{S}_{N+1}\\boldsymbol{m}^{\\prime}_{N+1} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\n"

#: ../../ml/bayes.rst:426
#, python-brace-format
msgid ""
"=\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\n"
msgstr ""
"=\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\n"

#: ../../ml/bayes.rst:437
msgid "ここで"
msgstr "Here we have made the following definitions."

#: ../../ml/bayes.rst:439
#, python-brace-format
msgid ""
"\\boldsymbol{S}_{N+1}^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} ,\n"
"\n"
msgstr ""
"\\boldsymbol{S}_{N+1}^{-1}\n"
"\\equiv\n"
"\\boldsymbol{S}_N^{-1} + \\beta\\boldsymbol{\\Phi}_{\\rm "
"new}^\\top\\boldsymbol{\\Phi}_{\\rm new} ,\n"
"\n"

#: ../../ml/bayes.rst:445
#, python-brace-format
msgid ""
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\equiv\n"
"\\beta\\boldsymbol{I} - \\beta^2\\boldsymbol{\\Phi}_{\\rm new}  "
"\\boldsymbol{S}_{N+1} \\boldsymbol{\\Phi}^\\top_{\\rm new} ,\n"
"\n"
msgstr ""
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\equiv\n"
"\\beta\\boldsymbol{I} - \\beta^2\\boldsymbol{\\Phi}_{\\rm new}  "
"\\boldsymbol{S}_{N+1} \\boldsymbol{\\Phi}^\\top_{\\rm new} ,\n"
"\n"

#: ../../ml/bayes.rst:451
#, python-brace-format
msgid ""
"\\boldsymbol{m}^{\\prime}_{N+1}\n"
"\\equiv\n"
"\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top\n"
"\\left(\n"
"\\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm new} "
"\\boldsymbol{m}_{N}\n"
"\\right) ,\n"
"\n"
msgstr ""
"\\boldsymbol{m}^{\\prime}_{N+1}\n"
"\\equiv\n"
"\\beta\\boldsymbol{\\Phi}_{\\rm new}^\\top\n"
"\\left(\n"
"\\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm new} "
"\\boldsymbol{m}_{N}\n"
"\\right) ,\n"
"\n"

#: ../../ml/bayes.rst:460
#, python-brace-format
msgid ""
"\\boldsymbol{m}_{N+1}\n"
"\\equiv\n"
"\\boldsymbol{S}_{N+1}\n"
"\\left(\n"
"\\boldsymbol{S}_N^{-1} \\boldsymbol{m}_N\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top_{\\rm new} \\boldsymbol{t}_{\\rm new}\n"
"\\right) ,\n"
"\n"
msgstr ""
"\\boldsymbol{m}_{N+1}\n"
"\\equiv\n"
"\\boldsymbol{S}_{N+1}\n"
"\\left(\n"
"\\boldsymbol{S}_N^{-1} \\boldsymbol{m}_N\n"
"+ \\beta \\boldsymbol{\\Phi}^\\top_{\\rm new} \\boldsymbol{t}_{\\rm new}\n"
"\\right) ,\n"
"\n"

#: ../../ml/bayes.rst:470
#, python-brace-format
msgid ""
"とおいた。式 :eq:`bayes22` の最後の等式は、\\ :ref:`matform1`\\ を用いて導ける。 \\ "
":eq:`bayes16` に戻って、 :math:`\\boldsymbol{w}` についての\\ "
":ref:`ガウス積分<gaussian_intg>`\\ を実行すると"
msgstr ""
"The last equality in Equation :eq:`bayes22` follows from the \\ "
":ref:`inverse matrix formula (1) <matform1>`\\ . Returning to Equation \\"
" :eq:`bayes16`, we integrate over :math:`\\boldsymbol{w}` by evaluating "
"the following \\ :ref:`Gaussian integral <gaussian_intg>`\\ ."

#: ../../ml/bayes.rst:473
msgid ""
"\\int d\\boldsymbol{w}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)\n"
"\\right)}\n"
"=\n"
"\\sqrt{ \\left( 2\\pi \\right)^M \\left| \\boldsymbol{S}_{N+1} \\right| }"
"\n"
"\n"
msgstr ""
"\\int d\\boldsymbol{w}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)^\\top\n"
"\\boldsymbol{S}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{w} - \\boldsymbol{m}_{N+1} \\right)\n"
"\\right)}\n"
"=\n"
"\\sqrt{ \\left( 2\\pi \\right)^M \\left| \\boldsymbol{S}_{N+1} \\right| }"
"\n"
"\n"

#: ../../ml/bayes.rst:484
msgid "なので、"
msgstr "This gives the following predictive distribution."

#: ../../ml/bayes.rst:486
msgid ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{\\sqrt{(2\\pi)^M\\left| \\boldsymbol{S}_{N+1} \\right|}}\n"
"{\\sqrt{(2\\pi)^N\\beta^{-N}} \\sqrt{(2\\pi)^M\\left| \\boldsymbol{S}_N "
"\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\\right)}\n"
"\n"
msgstr ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{\\sqrt{(2\\pi)^M\\left| \\boldsymbol{S}_{N+1} \\right|}}\n"
"{\\sqrt{(2\\pi)^N\\beta^{-N}} \\sqrt{(2\\pi)^M\\left| \\boldsymbol{S}_N "
"\\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}_{N+1}^{-1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\\right)}\n"
"\n"

#: ../../ml/bayes.rst:498
msgid ""
"となるが、\\ :ref:`行列式の公式<matform_blockdet>`\\ を用いて係数を整理すると、 "
"最終的に出力データの予測分布は以下のようになる"
msgstr ""
"Using the \\ :ref:`determinant formula <matform_blockdet>`\\  to simplify"
" the prefactor gives the final form of the predictive distribution for "
"the outputs."

#: ../../ml/bayes.rst:501
msgid ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N \\left| \\boldsymbol{A}_{N+1} \\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
"\\boldsymbol{A}^{-1}_{N+1}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)\n"
"\\right)} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{t}_{\\rm new} | \\boldsymbol{X}_{\\rm new}, "
"\\boldsymbol{X}_N, \\boldsymbol{t}_N)\n"
"=\n"
"\\frac{1}{\\sqrt{(2\\pi)^N \\left| \\boldsymbol{A}_{N+1} \\right|}}\n"
"\\exp{\\left(\n"
"-\\frac{1}{2}\n"
"\\left( \\boldsymbol{t}_{\\rm new} - \\boldsymbol{\\Phi}_{\\rm "
"new}\\boldsymbol{m}_N \\right)^\\top\n"
